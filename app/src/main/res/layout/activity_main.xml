<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:backgroundTint="#061A73"
    android:backgroundTintMode="add"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="413dp"
        android:layout_height="360dp"
        android:background="#4F7D59"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.666">

        <TextView
            android:id="@+id/textView"
            android:layout_width="380dp"
            android:layout_height="104dp"
            android:text="GeoResgistro"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#F1EDB0"
            android:textSize="48sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.484"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.937" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="411dp"
        android:layout_height="532dp"
        android:background="#FFFFFF"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.986">

        <ImageButton
            android:id="@+id/btnRegistrar"
            style="@android:style/Widget.Material.Light.ImageButton"
            android:layout_width="121dp"
            android:layout_height="124dp"
            android:backgroundTint="#F0F0F0"
            android:scaleType="fitStart"
            android:tint="#3A5E43"
            app:layout_constraintBottom_toTopOf="@+id/btnMapa"
            app:layout_constraintEnd_toStartOf="@+id/btnListado"
            app:layout_constraintHorizontal_bias="0.442"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.591"
            app:srcCompat="@drawable/baseline_add_24" />

        <ImageButton
            android:id="@+id/btnListado"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_marginTop="64dp"
            android:layout_marginEnd="48dp"
            android:backgroundTint="#F0F0F0"
            android:scaleType="fitStart"
            android:tint="#3A5E43"
            app:layout_constraintBottom_toTopOf="@+id/btnMapa"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.296"
            app:srcCompat="@drawable/baseline_list_alt_24" />

        <ImageButton
            android:id="@+id/btnMapa"
            android:layout_width="124dp"
            android:layout_height="122dp"
            android:backgroundTint="#F0F0F0"
            android:scaleType="fitStart"
            android:tint="#3A5E43"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.68"
            app:srcCompat="@drawable/ic_mapa" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>